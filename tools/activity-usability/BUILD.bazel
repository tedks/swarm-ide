package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.sh", "*.mjs", "*.cjs", "README.md"]))

sh_binary(
    name = "central-refresh",
    srcs = ["central-refresh.sh"],
    data = [":sources", ":smoke"],
    tags = ["manual"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [
        ":sources",
        "//:desktop-bundle",
        "//tools:virtual-desktop-run.sh",
        "//tools:x11-driver-source",
        "//tools:electron-runtime-source",
        "//tools/task-integration:sources",
    ],
    tags = ["manual"],
)
