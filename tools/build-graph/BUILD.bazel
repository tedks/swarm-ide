sh_binary(name = "target-probe-build", srcs = ["target-probe-build.sh"])
genrule(name = "target-probe-module", srcs = ["//:quality_sources", "//:package.json"], outs = ["target-probe.cjs"], cmd = "$(location :target-probe-build) $@ $(location //:package.json)", tools = [":target-probe-build"], local = True)
sh_binary(name = "target-probe", srcs = ["target-probe.sh"], data = [":sources", ":target-probe-module", "//:desktop-bundle"], tags = ["manual"])
