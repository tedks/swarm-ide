filegroup(name = "sources", srcs = glob(["*.mjs", "*.cjs", "*.sh"]))
sh_test(
    name = "checks",
    srcs = ["checks.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)
sh_test(
    name = "progress-checks",
    srcs = ["progress-checks.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)
