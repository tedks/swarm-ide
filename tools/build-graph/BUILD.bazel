    env_inherit = ["SWARM_ELECTRON_BIN", "SWARM_ELECTRON_NO_SANDBOX", "SWARM_SOURCE_WORKSPACE", "SWARM_VIRTUAL_DESKTOP_PORT", "SWARM_BAZEL_BIN", "SWARM_BAZEL_JAVA_HOME"],
    tags = ["desktop", "exclusive", "local", "no-sandbox"],
