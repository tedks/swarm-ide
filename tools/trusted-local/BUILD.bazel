package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["*.ts", "*.cjs", "*.mjs", "*.sh"]),
)

sh_test(
    name = "session-unit",
    srcs = ["session-unit.sh"],
    data = [":sources", "//:quality_sources"],
    tags = ["local"],
)

genrule(
    name = "activity-live-bundle",
    srcs = ["build-activity-live.sh", ":sources", "//:quality_sources", "//:package.json"],
    outs = ["activity-live-proof.cjs"],
    cmd = "bash $(location build-activity-live.sh) $@ $(location //:package.json)",
    tags = ["manual", "local"],
)

sh_binary(
    name = "activity-live",
    srcs = ["activity-live.sh"],
    data = [":activity-live-bundle", "//:quality_sources"],
    tags = ["manual"],
)

genrule(
    name = "live-bundle",
    srcs = ["build-live.sh", ":sources", "//:quality_sources", "//:package.json"],
    outs = ["live-proof.cjs"],
    cmd = "bash $(location build-live.sh) $@ $(location //:package.json)",
    tags = ["manual", "local"],
)

sh_binary(
    name = "live-smoke",
    srcs = ["live-smoke.sh"],
    data = [":live-bundle", "//:quality_sources"],
    tags = ["manual"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//:quality_sources", "//tools/task-integration:sources", "//tools:virtual-desktop-run.sh", "//tools:x11-driver-source", "//tools:electron-runtime-source"],
    tags = ["manual"],
)
