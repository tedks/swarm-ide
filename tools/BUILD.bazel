package(default_visibility = ["//visibility:public"])

filegroup(
    name = "dev-port-source",
    srcs = ["dev-port.mjs"],
)

filegroup(
    name = "x11-driver-source",
    srcs = ["x11-driver.sh"],
)

sh_binary(
    name = "dev",
    srcs = ["dev.sh"],
)

sh_binary(
    name = "build-app",
    srcs = ["build-app.sh"],
)

sh_binary(
    name = "extract-service-topology",
    srcs = ["extract-service-topology.mjs"],
)

sh_test(
    name = "quality",
    srcs = ["quality.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

sh_binary(
    name = "desktop-smoke",
    srcs = ["desktop-smoke.sh"],
    tags = ["manual"],
)

sh_binary(
    name = "desktop-zoom-smoke",
    srcs = ["desktop-zoom-smoke.sh"],
    tags = ["manual"],
)

sh_test(
    name = "x11-driver-test",
    srcs = ["x11-driver.test.sh"],
    data = [":x11-driver-source"],
)

sh_binary(
    name = "measure-hmr",
    srcs = ["measure-hmr.sh"],
    tags = ["manual"],
)
