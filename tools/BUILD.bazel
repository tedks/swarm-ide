package(default_visibility = ["//visibility:public"])

filegroup(
    name = "agent-rehearsal-sources",
    srcs = glob(["agent-rehearsal/*"]),
)

sh_binary(
    name = "build-agent-rehearsal",
    srcs = ["agent-rehearsal/build.sh"],
    data = [":agent-rehearsal-sources"],
)

genrule(
    name = "agent-rehearsal-bundle",
    srcs = ["//:quality_sources", "//:package.json"],
    outs = ["agent-rehearsal.tar.gz"],
    cmd = "$(location :build-agent-rehearsal) $@ $(location //:package.json)",
    tools = [":build-agent-rehearsal"],
    local = True,
)

sh_binary(
    name = "agent-rehearsal",
    srcs = ["agent-rehearsal/launch.sh"],
    data = [":agent-rehearsal-sources", ":agent-rehearsal-bundle"],
    tags = ["manual"],
)

sh_binary(
    name = "desktop-agent-rehearsal-smoke",
    srcs = ["agent-rehearsal/smoke.sh"],
    data = [":agent-rehearsal-sources", ":agent-rehearsal-bundle", ":virtual-desktop-run.sh", ":x11-driver-source"],
    tags = ["manual"],
)

sh_test(
    name = "virtual-desktop-agent-rehearsal-test",
    srcs = ["agent-rehearsal/smoke.sh"],
    data = [":agent-rehearsal-sources", ":agent-rehearsal-bundle", ":virtual-desktop-run.sh", ":x11-driver-source", "//:quality_sources"],
    env_inherit = ["DISPLAY", "XAUTHORITY", "SWARM_ELECTRON_BIN", "SWARM_ELECTRON_NO_SANDBOX", "SWARM_SOURCE_WORKSPACE", "SWARM_VIRTUAL_DESKTOP_PORT"],
    tags = ["desktop", "exclusive", "local", "no-sandbox"],
    timeout = "long",
)

filegroup(
    name = "agent-journey-sources",
    srcs = ["agent-journey-dev.mjs", "agent-journey-dev.sh", "agent-journey-client.mjs", "desktop-agent-scenario.sh", "desktop-agent-smoke.sh"],
)

sh_binary(
    name = "desktop-agent-smoke",
    srcs = ["desktop-agent-smoke.sh"],
    data = [":agent-journey-sources", ":virtual-desktop-run.sh", ":x11-driver-source"],
    tags = ["manual"],
)

sh_test(
    name = "virtual-desktop-agent-test",
    srcs = ["desktop-agent-smoke.sh"],
    data = [":agent-journey-sources", ":virtual-desktop-run.sh", ":x11-driver-source", "//:quality_sources"],
    env_inherit = ["DISPLAY", "XAUTHORITY", "SWARM_ELECTRON_BIN", "SWARM_ELECTRON_NO_SANDBOX", "SWARM_SOURCE_WORKSPACE", "SWARM_VIRTUAL_DESKTOP_PORT"],
    tags = ["desktop", "exclusive", "local", "no-sandbox"],
    timeout = "long",
)

filegroup(
    name = "dev-port-source",
    srcs = ["dev-port.mjs", "dev-update.mjs"],
)

filegroup(
    name = "electron-runtime-source",
    srcs = ["electron-runtime.mjs"],
)

filegroup(
    name = "x11-driver-source",
    srcs = ["x11-driver.sh"],
)

filegroup(
    name = "desktop-automation-sources",
    srcs = [
        "desktop-smoke.sh",
        "desktop-reload-smoke.sh",
        "desktop-reload-scenario.sh",
        "desktop-topology-scenario.sh",
        "desktop-zoom-scenario.sh",
        "desktop-zoom-smoke.sh",
        "hmr-scenario.sh",
        "hmr-scenario.test.sh",
        "measure-hmr.sh",
        "virtual-desktop-run.sh",
        "x11-driver.sh",
    ],
)

sh_binary(
    name = "dev",
    srcs = ["dev.sh"],
    data = ["dev-entry.mjs", "dev-port.mjs"],
)

filegroup(
    name = "dev-entry-sources",
    srcs = ["dev.sh", "dev.mjs", "dev-entry.mjs", "dev-workspace.test.mjs", "dev-workspace.test.sh"],
)

sh_test(
    name = "dev-workspace-test",
    srcs = ["dev-workspace.test.sh"],
    data = [":dev-entry-sources", ":dev-port-source"],
    tags = ["local"],
)

sh_binary(
    name = "build-app",
    srcs = ["build-app.sh"],
)

sh_binary(
    name = "extract-service-topology",
    srcs = ["extract-service-topology.mjs"],
)

sh_test(
    name = "quality",
    srcs = ["quality.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

sh_binary(
    name = "desktop-reload-smoke",
    srcs = ["desktop-reload-smoke.sh"],
    data = [":desktop-reload-scenario.sh", ":dev", ":virtual-desktop-run.sh", ":x11-driver-source"],
    tags = ["manual"],
)

sh_binary(
    name = "desktop-ui-sprint",
    srcs = ["desktop-ui-sprint.sh"],
    data = ["desktop-ui-sprint-scenario.sh", ":dev", ":virtual-desktop-run.sh", ":x11-driver-source"],
    tags = ["manual"],
)

sh_binary(
    name = "desktop-smoke",
    srcs = ["desktop-smoke.sh"],
    data = [
        ":desktop-topology-scenario.sh",
        ":dev",
        ":virtual-desktop-run.sh",
        ":x11-driver-source",
    ],
    tags = ["manual"],
)

sh_binary(
    name = "desktop-zoom-smoke",
    srcs = ["desktop-zoom-smoke.sh"],
    data = [
        ":desktop-zoom-scenario.sh",
        ":dev",
        ":virtual-desktop-run.sh",
        ":x11-driver-source",
    ],
    tags = ["manual"],
)

sh_test(
    name = "x11-driver-test",
    srcs = ["x11-driver.test.sh"],
    data = [":x11-driver-source"],
)

sh_test(
    name = "virtual-desktop-supervisor-test",
    srcs = ["virtual-desktop-supervisor.test.sh"],
    data = [
        ":virtual-desktop-run.sh",
        ":x11-driver-source",
    ],
)

sh_test(
    name = "hmr-scenario-test",
    srcs = ["hmr-scenario.test.sh"],
    data = [":hmr-scenario.sh"],
)

sh_test(
    name = "virtual-desktop-smoke-test",
    srcs = ["virtual-desktop-smoke.test.sh"],
    data = [":desktop-smoke"],
    env_inherit = [
        "DISPLAY",
        "SWARM_ELECTRON_BIN",
        "SWARM_ELECTRON_NO_SANDBOX",
        "SWARM_SOURCE_WORKSPACE",
        "SWARM_VIRTUAL_DESKTOP_PORT",
        "XAUTHORITY",
    ],
    tags = [
        "desktop",
        "exclusive",
        "local",
        "no-sandbox",
    ],
    timeout = "long",
)

sh_binary(
    name = "measure-hmr",
    srcs = ["measure-hmr.sh"],
    data = [
        ":dev",
        ":hmr-scenario.sh",
        ":virtual-desktop-run.sh",
        ":x11-driver-source",
    ],
    tags = ["manual"],
)
