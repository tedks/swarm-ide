package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.sh", "*.mjs", "*.cjs"]))

sh_test(
    name = "unit",
    srcs = ["unit.sh"],
    data = ["//:quality_sources", ":sources"],
    tags = ["local"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//tools:desktop-automation-sources", "//tools:x11-driver-source"],
    tags = ["manual"],
)

sh_binary(
    name = "fleet-smoke",
    srcs = ["fleet-smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//tools:desktop-automation-sources", "//tools:x11-driver-source"],
    tags = ["manual"],
)

sh_binary(
    name = "status-smoke",
    srcs = ["status-smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//tools:desktop-automation-sources", "//tools:x11-driver-source"],
    tags = ["manual"],
)
