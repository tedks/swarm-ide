package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.ts", "*.sh", "*.json"]))

genrule(
    name = "bundle",
    srcs = ["build.sh", ":sources", "//:quality_sources", "//:package.json"],
    outs = ["register.cjs"],
    cmd = "bash $(location build.sh) $@ $(location //:package.json)",
    tags = ["local"],
)

sh_binary(
    name = "register",
    srcs = ["register.sh"],
    data = [":bundle"],
    tags = ["manual"],
)

sh_test(
    name = "unit",
    srcs = ["unit.sh"],
    data = [":sources", ":bundle", "//:quality_sources", "//tools/cli:sources"],
    tags = ["local"],
    timeout = "moderate",
)
