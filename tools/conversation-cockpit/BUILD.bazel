package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.sh", "*.mjs", "*.cjs"]))

sh_test(
    name = "unit",
    srcs = ["unit.sh"],
    data = [":sources", "//:quality_sources"],
    tags = ["local"],
)

sh_test(
    name = "syntax",
    srcs = ["syntax.sh"],
    data = [":sources"],
    tags = ["local"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//tools:desktop-automation-sources", "//tools:x11-driver-source", "//tools:electron-runtime-source"],
    tags = ["manual"],
)
