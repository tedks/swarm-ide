package(default_visibility = ["//visibility:public"])

sh_test(
    name = "tab-overflow",
    srcs = ["tab-overflow.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

sh_test(
    name = "trusted-home",
    srcs = ["trusted-home.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

sh_test(
    name = "checks",
    srcs = ["checks.sh"],
    data = ["//:quality_sources", ":sources"],
    tags = ["local"],
)

sh_test(
    name = "regressions",
    srcs = ["regressions.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

filegroup(name = "sources", srcs = glob(["*.sh", "*.cjs"]))

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//tools:virtual-desktop-run.sh", "//tools:x11-driver-source", "//tools:electron-runtime-source", "//tools/task-integration:sources"],
    tags = ["manual"],
)
