package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.sh", "*.cjs", "*.mjs"]))

sh_test(
    name = "checks",
    srcs = ["checks.sh"],
    data = ["//:quality_sources", ":sources"],
    tags = ["local"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//tools:desktop-automation-sources", "//tools:x11-driver-source", "//tools/demo-agents:sources"],
    tags = ["manual"],
)
