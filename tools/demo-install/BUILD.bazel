package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["*.sh", "*.mjs"]),
)

sh_test(
    name = "startup-guard-test",
    srcs = ["startup-test.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//tools:virtual-desktop-run.sh", "//tools:x11-driver-source"],
    tags = ["manual"],
)
