package(default_visibility = ["//visibility:public"])

sh_test(
    name = "graph-checks",
    srcs = ["graph-checks.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

sh_test(
    name = "regressions",
    srcs = ["regressions.sh"],
    data = ["//:quality_sources"],
    tags = ["local"],
)

filegroup(
    name = "sources",
    srcs = glob(["*.mjs", "*.cjs", "*.sh"]),
)

sh_test(
    name = "packaged-plans-test",
    srcs = ["smoke.sh"],
    data = [
        ":sources",
        "//:desktop-bundle",
        "//tools:electron-runtime-source",
        "//tools:virtual-desktop-run.sh",
        "//tools:x11-driver-source",
        "//tools/task-integration:sources",
    ],
    env_inherit = ["SWARM_ELECTRON_BIN", "SWARM_ELECTRON_NO_SANDBOX", "SWARM_SOURCE_WORKSPACE", "SWARM_VIRTUAL_DISPLAY", "SWARM_VIRTUAL_DESKTOP_PORT", "SWARM_PLANS_CASE"],
    tags = ["desktop", "exclusive", "local", "no-sandbox"],
    timeout = "long",
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [
        ":sources",
        "//:desktop-bundle",
        "//tools:electron-runtime-source",
        "//tools:virtual-desktop-run.sh",
        "//tools:x11-driver-source",
        "//tools/task-integration:sources",
    ],
    tags = ["manual"],
)
