package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.mjs", "*.cjs", "*.sh", "*.ts"]))

genrule(
    name = "registration-bundle",
    srcs = ["build-registration.sh", ":sources", "//tools/session-registration:sources", "//:quality_sources", "//:package.json"],
    outs = ["registration.cjs"],
    cmd = "bash $(location build-registration.sh) $@ $(location //:package.json)",
    tags = ["local"],
)

sh_test(
    name = "checks",
    srcs = ["checks.sh"],
    data = [":sources"],
    tags = ["local"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//tools:virtual-desktop-run.sh", "//tools:x11-driver-source", "//tools/task-integration:sources"],
    tags = ["manual"],
)
