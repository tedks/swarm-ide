package(default_visibility = ["//visibility:public"])

filegroup(name = "sources", srcs = glob(["*.sh", "*.ts", "*.cjs", "*.mjs"]))

sh_test(
    name = "checks",
    srcs = ["checks.sh"],
    data = ["//:quality_sources", ":sources"],
    local = True,
    timeout = "short",
)

genrule(
    name = "live-bundle",
    srcs = ["build-live.sh", ":sources", "//:quality_sources", "//:package.json"],
    outs = ["live.cjs"],
    cmd = "bash $(location build-live.sh) $@ $(location //:package.json)",
    local = True,
    tags = ["manual"],
)

sh_binary(
    name = "live",
    srcs = ["live.sh"],
    data = [":live-bundle", "//:quality_sources"],
    tags = ["manual"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//:quality_sources", "//tools/task-integration:sources", "//tools:virtual-desktop-run.sh", "//tools:x11-driver-source", "//tools:electron-runtime-source"],
    tags = ["manual"],
)
