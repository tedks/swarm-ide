package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["*.ts", "*.cjs", "*.mjs", "*.sh"]),
)

sh_binary(
    name = "author",
    srcs = ["author.sh"],
    data = [":sources", "//:quality_sources"],
    tags = ["manual"],
)

sh_binary(
    name = "smoke",
    srcs = ["smoke.sh"],
    data = [":sources", "//:desktop-bundle", "//:quality_sources", "//tools:virtual-desktop-run.sh", "//tools:x11-driver-source", "//tools:electron-runtime-source"],
    tags = ["manual"],
)
