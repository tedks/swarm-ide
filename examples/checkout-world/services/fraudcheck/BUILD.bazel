package(default_visibility = ["//visibility:public"])

filegroup(
    name = "fraudcheck_sources",
    srcs = [
        "fraudcheck.proto",
        "fraudcheck.ts",
    ],
)

proto_library(
    name = "fraudcheck_proto",
    srcs = ["fraudcheck.proto"],
)

genrule(
    name = "service_topology",
    srcs = [
        "fraudcheck.proto",
        "fraudcheck.ts",
        "service.swarm.json",
        "//examples/checkout-world/services/payments:payments.proto",
    ],
    outs = ["service-topology.json"],
    cmd = " ".join([
        "$(location //tools:extract-service-topology)",
        "--manifest $(location service.swarm.json)",
        "--owning-target //examples/checkout-world/services/fraudcheck:fraudcheck_sources",
        "--source examples/checkout-world/services/fraudcheck/fraudcheck.proto=$(location fraudcheck.proto)",
        "--source examples/checkout-world/services/fraudcheck/fraudcheck.ts=$(location fraudcheck.ts)",
        "--interface-source interface:fraud-check.assess=examples/checkout-world/services/fraudcheck/fraudcheck.proto=$(location fraudcheck.proto)",
        "--interface-source interface:payments.authorize=examples/checkout-world/services/payments/payments.proto=$(location //examples/checkout-world/services/payments:payments.proto)",
        "--out $@",
    ]),
    tools = ["//tools:extract-service-topology"],
)
