package(default_visibility = ["//visibility:public"])

exports_files(["flake.lock"])

filegroup(
    name = "runtime_sources",
    srcs = glob([
        "app/**",
        "core/**",
        "fixtures/**",
        "protocol/**",
    ]) + [
        "index.html",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.mts",
    ],
)

filegroup(
    name = "quality_sources",
    srcs = glob(["tests/**", "examples/**", ".swarm/**"]) + [
        ":runtime_sources",
        "vitest.config.mts",
        "//tools:dev-port-source",
        "//tools:dev-entry-sources",
        "//tools:electron-runtime-source",
        "//tools:desktop-automation-sources",
        "//tools:agent-journey-sources",
        "//tools:agent-rehearsal-sources",
        "//tools/policy:sources",
        "//tools/task-integration:sources",
        "//tools/repository-navigation:sources",
        "//tools/demo-journal:sources",
        "//tools/demo-plans:sources",
        "//tools/demo-agents:sources",
        "//tools/build-graph:sources",
        "//tools/session-registration:sources",
        "//tools/cli:sources",
        "//tools/conversation-cockpit:sources",
        "//tools/work-log:sources",
    ],
)

# Additional documents, source paths and BUILD text read by the design gate.
filegroup(
    name = "design_test_inputs",
    srcs = [
        "//docs/design:sources",
        "//:docs/container-demo.md",
        "//:Dockerfile",
        "//examples/checkout-world:README.md",
        "//examples/checkout-world/services/fraudcheck:service.swarm.json",
        "//examples/checkout-world/services/payments:service.swarm.json",
        "//:nix/package.nix",
        "//tools:build-app.sh",
        "//tools/container:entrypoint.sh",
        "//tools/container:runtime.nix",
        "//tools/services:inspect.ts",
        "//:BUILD.bazel",
        "//docs/design:BUILD.bazel",
        "//examples/checkout-world:BUILD.bazel",
        "//examples/checkout-world/services/fraudcheck:BUILD.bazel",
        "//examples/checkout-world/services/payments:BUILD.bazel",
        "//tools:BUILD.bazel",
        "//tools/activity-usability:BUILD.bazel",
        "//tools/bazel-palette:BUILD.bazel",
        "//tools/build-graph:BUILD.bazel",
        "//tools/cli:BUILD.bazel",
        "//tools/component-plan:BUILD.bazel",
        "//tools/container:BUILD.bazel",
        "//tools/context-source-links:BUILD.bazel",
        "//tools/conversation-cockpit:BUILD.bazel",
        "//tools/demo-agents:BUILD.bazel",
        "//tools/demo-journal:BUILD.bazel",
        "//tools/demo-plans:BUILD.bazel",
        "//tools/design-tests:BUILD.bazel",
        "//tools/fleet-cockpit:BUILD.bazel",
        "//tools/graph-recenter:BUILD.bazel",
        "//tools/live-observers:BUILD.bazel",
        "//tools/live-sprites:BUILD.bazel",
        "//tools/living-design:BUILD.bazel",
        "//tools/message-outbox:BUILD.bazel",
        "//tools/operator-cockpit:BUILD.bazel",
        "//tools/project-context:BUILD.bazel",
        "//tools/renderer-health:BUILD.bazel",
        "//tools/services:BUILD.bazel",
        "//tools/session-registration:BUILD.bazel",
        "//tools/task-integration:BUILD.bazel",
        "//tools/trusted-local:BUILD.bazel",
        "//tools/work-log:BUILD.bazel",
        "//tools/workspace-navigation:BUILD.bazel",
        "//tools/worktree-browser:BUILD.bazel",
    ],
)

genrule(
    name = "desktop-bundle",
    # Direct label is required by $(location package.json), despite group membership.
    srcs = [":runtime_sources", "package.json"],
    outs = ["swarm-ide-foundation.tar.gz"],
    cmd = "$(location //tools:build-app) $@ $(location package.json)",
    local = True,
    tools = ["//tools:build-app"],
)

alias(
    name = "dev",
    actual = "//tools:dev",
)

test_suite(
    name = "quality",
    tests = ["//tools:quality"],
)
