package(default_visibility = ["//visibility:public"])

filegroup(
    name = "quality_sources",
    srcs = glob([
        "app/**",
        "core/**",
        "fixtures/**",
        "protocol/**",
        "tests/**",
    ]) + [
        "index.html",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.mts",
        "vitest.config.mts",
    ],
)

alias(
    name = "dev",
    actual = "//tools:dev",
)

test_suite(
    name = "quality",
    tests = ["//tools:quality"],
)
