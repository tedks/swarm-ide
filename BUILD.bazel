package(default_visibility = ["//visibility:public"])

exports_files(["flake.lock"])

filegroup(
    name = "quality_sources",
    srcs = glob([
        "app/**",
        "core/**",
        "fixtures/**",
        "protocol/**",
        "tests/**",
        "examples/**",
        ".swarm/changelog*.json",
    ]) + [
        "index.html",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.mts",
        "vitest.config.mts",
    ] + [
        "//tools:dev-port-source",
        "//tools:dev-entry-sources",
        "//tools:electron-runtime-source",
        "//tools:extract-service-topology",
        "//tools:desktop-automation-sources",
        "//tools:agent-journey-sources",
        "//tools:agent-rehearsal-sources",
        "//tools/policy:sources",
        "//tools/task-integration:sources",
        "//tools/repository-navigation:sources",
        "//tools/demo-journal:sources",
        "//tools/build-graph:sources",
    ],
)

genrule(
    name = "desktop-bundle",
    srcs = [":quality_sources", "package.json"],
    outs = ["swarm-ide-foundation.tar.gz"],
    cmd = "$(location //tools:build-app) $@ $(location package.json)",
    local = True,
    tools = ["//tools:build-app"],
)

alias(
    name = "dev",
    actual = "//tools:dev",
)

test_suite(
    name = "quality",
    tests = ["//tools:quality"],
)
